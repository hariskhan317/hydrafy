{
  "expo": {
    "name": "Hydrafy",
    "slug": "hydrafy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hydrafy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haris.hydrafy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.haris.hydrafy"
    },
    "web": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#3fa8d6"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e43d2d58-bfba-44b9-a1b3-3efe8d92d360"
      }
    }
  }
}
